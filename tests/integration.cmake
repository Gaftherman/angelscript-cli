cmake_minimum_required(VERSION 3.21)

function(check_cli expected_exit expected_stdout expected_error)
    execute_process(COMMAND "${CLI}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr ENCODING UTF-8 TIMEOUT 10)
    string(REPLACE "\r\n" "\n" stdout "${stdout}")
    string(REPLACE "\r\n" "\n" stderr "${stderr}")

    if(NOT status STREQUAL "${expected_exit}")
        message(FATAL_ERROR "Expected exit ${expected_exit}, got ${status}\nstdout: ${stdout}\nstderr: ${stderr}")
    endif()
    if(NOT stdout MATCHES "${expected_stdout}")
        message(FATAL_ERROR "Expected stdout matching [${expected_stdout}], got [${stdout}]")
    endif()
    if(NOT stderr MATCHES "${expected_error}")
        message(FATAL_ERROR "Expected stderr matching [${expected_error}], got [${stderr}]")
    endif()
endfunction()

set(fixtures "${CMAKE_CURRENT_LIST_DIR}/fixtures")

if(CASE STREQUAL "hello")
    check_cli(0 "^hello, world!\n$" "^$" "${fixtures}/hello.as")
elseif(CASE STREQUAL "args")
    string(ASCII 195 169 accent)
    check_cli(0 "^count=4\n\\[--check\\]\n\\[two words\\]\n\\[--dap-port\\]\n\\[caf${accent}\\]\n$"
        "^$" "${fixtures}/args.as" --check "two words" --dap-port "caf${accent}")
elseif(CASE STREQUAL "stdlib")
    check_cli(0 "^sum=9\n$" "^$" "${fixtures}/stdlib.as")
elseif(CASE STREQUAL "filesystem")
    string(RANDOM LENGTH 16 ALPHABET "0123456789abcdef" suffix)
    check_cli(0 "^file contents\n$" "^$" "${fixtures}/filesystem.as" "cli-test-${suffix}")
elseif(CASE STREQUAL "datetime")
    check_cli(0 "^[0-9]+-[0-9]+-[0-9]+\n$" "^$" "${fixtures}/datetime.as")
elseif(CASE STREQUAL "int-main")
    check_cli(7 "^$" "^$" "${fixtures}/int-main.as")
elseif(CASE STREQUAL "void-main")
    check_cli(0 "^void main\n$" "^$" run --no-jit "${fixtures}/void-main.as")
elseif(CASE STREQUAL "compile-error")
    check_cli(1 "^$" "compile-error\\.as:[0-9]+:[0-9]+: error: " "${fixtures}/compile-error.as")
elseif(CASE STREQUAL "exception")
    check_cli(1 "^$"
        "Unhandled exception: Index out of bounds\n  at int fail\\(\\) \\([^\n]+exception\\.as:[0-9]+\\)\n  at void main\\(\\) \\([^\n]+exception\\.as:[0-9]+\\)"
        "${fixtures}/exception.as")
elseif(CASE STREQUAL "check-ok")
    check_cli(0 "^$" "^$" --check "${fixtures}/check-only.as")
    check_cli(0 "^$" "^$" check "${fixtures}/check-only.as")
elseif(CASE STREQUAL "check-fail")
    check_cli(1 "^$" "compile-error\\.as:[0-9]+:[0-9]+: error: " --check "${fixtures}/compile-error.as")
elseif(CASE STREQUAL "net-echo")
    check_cli(0 "^pong:ping\n$" "^$" "${fixtures}/net-echo.as")
elseif(CASE STREQUAL "net-refused")
    check_cli(1 "^$" "tcpConnect" "${fixtures}/net-refused.as")
elseif(CASE STREQUAL "net-closed")
    check_cli(0 "^received=0\n$" "^$" "${fixtures}/net-closed.as")
elseif(CASE STREQUAL "examples")
    set(examples "${CMAKE_CURRENT_LIST_DIR}/../examples")
    check_cli(0 "^Hello, world!\n$" "^$" "${examples}/hello.as")
    check_cli(0 "^Hello, Ada!\n$" "^$" "${examples}/hello.as" Ada)
    check_cli(0 "words: 4\njoined: [^\n]+\n" "^$" "${examples}/strings.as")
    check_cli(0 "seconds apart: 5400\n" "^$" "${examples}/dates.as")
    check_cli(0 "client got: echo: hello over tcp" "^$" "${examples}/tcp-echo.as")
    check_cli(60 "^sum = 60\n$" "^$" "${examples}/sum.as" 10 20 30)
    check_cli(0 "^alpha[.]txt\nbeta[.]txt\ngamma[.]txt\n$" "^$" "${examples}/listdir.as")
    check_cli(0 "size: 23 bytes" "^$" "${examples}/files.as")
elseif(CASE STREQUAL "include")
    check_cli(0 "^included: 42\n$" "^$" "${fixtures}/include.as")
elseif(CASE STREQUAL "no-entry")
    check_cli(1 "^$" "^no entry point `int main\\(\\)` or `void main\\(\\)`\n$" "${fixtures}/check-only.as")
elseif(CASE STREQUAL "usage")
    check_cli(2 "^$" "Expected a script path")
    check_cli(2 "^$" "--dap-port requires a value" --dap-port)
    check_cli(2 "^$" "--dap-port requires a number from 1 to 65535" --dap-port 65536 "${fixtures}/hello.as")
    check_cli(2 "^$" "Unknown option --unknown" --unknown "${fixtures}/hello.as")
elseif(CASE STREQUAL "install" OR CASE STREQUAL "init")
    check_cli(2 "^$" "^planned for a future version\n$" "${CASE}")
elseif(CASE STREQUAL "version")
    string(REPLACE "." "[.]" version_pattern "${VERSION}")
    string(REPLACE "." "[.]" engine_pattern "${ENGINE_VERSION}")
    check_cli(0 "^angelscript ${version_pattern}[ ]\\(AngelScript ${engine_pattern}, jit: ${EXPECTED_JIT}\\)\n$" "^$" --version)
elseif(CASE STREQUAL "dump-predefined")
    if(ENGINE_NUMBER GREATER_EQUAL 23900)
        check_cli(0 "void println\\(const string&in\\);" "^$" --dump-predefined)
    else()
        check_cli(2 "^$" "needs an engine built against AngelScript 2[.]39[.]0" --dump-predefined)
    endif()
elseif(CASE STREQUAL "help")
    check_cli(0 "^Usage: angelscript " "^$" --help)
else()
    message(FATAL_ERROR "Unknown integration case ${CASE}")
endif()
