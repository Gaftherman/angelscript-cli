cmake_minimum_required(VERSION 3.21)

foreach(arg IN ITEMS BUILD_DIR CONFIG VERSION OS ARCH)
    if(NOT DEFINED ${arg} OR "${${arg}}" STREQUAL "")
        message(FATAL_ERROR "Pass -D${arg}=... before -P scripts/package.cmake")
    endif()
endforeach()
if(NOT VERSION MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$")
    message(FATAL_ERROR "VERSION must be x.y.z")
endif()
if(NOT OS MATCHES "^(windows|linux|macos)$" OR NOT ARCH MATCHES "^(x64|x86|arm64)$")
    message(FATAL_ERROR "Use OS=windows|linux|macos and ARCH=x64|x86|arm64")
endif()
if(ARCH STREQUAL "x86" AND OS STREQUAL "macos")
    message(FATAL_ERROR "macOS has no x86 build")
endif()

set(program angelscript)
if(OS STREQUAL "windows")
    string(APPEND program ".exe")
    set(extension zip)
    set(tar_mode cf)
    set(format zip)
else()
    set(extension tar.gz)
    set(tar_mode czf)
    set(format gnutar)
endif()

set(binary "${BUILD_DIR}/bin/${CONFIG}/${program}")
if(NOT EXISTS "${binary}")
    # The CLI target writes here even when using Ninja Multi-Config.
    set(binary "${BUILD_DIR}/bin/${program}")
endif()
if(NOT EXISTS "${binary}" OR IS_DIRECTORY "${binary}")
    message(FATAL_ERROR "Built executable not found at ${binary}")
endif()

get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(dist "${root}/dist")
# ENGINE names a build against a given official AngelScript release (angelscript-cli-<v>-as<engine>-...), and JIT=ON
# marks one built with the angelscript-jit compiler (angelscript-cli-<v>-as<engine>-jit-...). A build against the
# bundled release with neither is the plain package.
if(DEFINED ENGINE AND NOT ENGINE STREQUAL "")
    set(asset_base "angelscript-cli-${VERSION}-as${ENGINE}")
    if(JIT)
        string(APPEND asset_base "-jit")
    endif()
    set(asset_base "${asset_base}-${OS}-${ARCH}")
else()
    set(asset_base "angelscript-cli-${VERSION}-${OS}-${ARCH}")
endif()
set(asset "${asset_base}.${extension}")
file(MAKE_DIRECTORY "${dist}")
file(LOCK "${dist}/.package.lock" GUARD PROCESS TIMEOUT 60)

string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(work "${dist}/.package-${suffix}")
set(stage "${work}/stage")
file(MAKE_DIRECTORY "${stage}")
file(COPY "${binary}" "${root}/LICENSE" "${root}/docs/THIRD_PARTY_NOTICES.md" "${root}/README.md" DESTINATION "${stage}")
execute_process(
    COMMAND "${CMAKE_COMMAND}" -E tar "${tar_mode}" "${work}/${asset}" "--format=${format}" -- "${program}" LICENSE THIRD_PARTY_NOTICES.md README.md
    WORKING_DIRECTORY "${stage}"
    RESULT_VARIABLE status)
if(NOT status STREQUAL "0")
    file(REMOVE_RECURSE "${work}")
    message(FATAL_ERROR "Could not create ${asset}: ${status}")
endif()

set(manifest "${dist}/SHA256SUMS")
if(EXISTS "${manifest}")
    file(STRINGS "${manifest}" sums)
    string(REPLACE "." "[.]" asset_pattern "${asset}")
    list(FILTER sums EXCLUDE REGEX "^[0-9A-Fa-f]+  ${asset_pattern}$")
endif()
file(SHA256 "${work}/${asset}" hash)
list(APPEND sums "${hash}  ${asset}")
list(SORT sums)
list(JOIN sums "\n" sums_text)
file(WRITE "${work}/SHA256SUMS" "${sums_text}\n")
file(RENAME "${work}/${asset}" "${dist}/${asset}")
file(RENAME "${work}/SHA256SUMS" "${manifest}")
# What the build supports (AngelScript version, JIT, add-ons). The setup program shows it next to each release.
if(EXISTS "${BUILD_DIR}/engine-info.json")
    file(COPY_FILE "${BUILD_DIR}/engine-info.json" "${dist}/${asset_base}.json")
endif()
file(REMOVE_RECURSE "${work}")
message(STATUS "Created ${dist}/${asset}")
